; poligraph — convenções de código
; Regras derivadas de .claude/skills/padroes-codigo/SKILL.md
; Severidade: warning para estilo, error para o que quebra o projeto

root = true

# ───────────────────────────────────────────────────────────────
[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{json,yml,yaml,md,tsx,ts,jsx,js,css,html}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false   # dois espaços = quebra de linha

[*.{py,cfg}]
indent_size = 4

[*.{csproj,props,targets,xml}]
indent_size = 2

# ═══════════════════════════════════════════════════════════════
# C#
# ═══════════════════════════════════════════════════════════════
[*.cs]
indent_size = 4
max_line_length = 110

# ─── using ─────────────────────────────────────────────────────
dotnet_sort_system_directives_first = true
dotnet_separate_import_directive_groups = false
csharp_using_directive_placement = outside_namespace:warning

# ─── namespace de uma linha só ─────────────────────────────────
csharp_style_namespace_declarations = file_scoped:warning

# ═══════════════════════════════════════════════════════════════
# NOMENCLATURA  — a regra do projeto
# ═══════════════════════════════════════════════════════════════

# ─── Tudo que é público: PascalCase ────────────────────────────
dotnet_naming_rule.membros_publicos_pascal.symbols  = simbolos_publicos
dotnet_naming_rule.membros_publicos_pascal.style    = pascal
dotnet_naming_rule.membros_publicos_pascal.severity = warning

dotnet_naming_symbols.simbolos_publicos.applicable_kinds = property,method,field,event,delegate
dotnet_naming_symbols.simbolos_publicos.applicable_accessibilities = public,internal,protected,protected_internal

# ─── Tipos e namespaces: PascalCase ────────────────────────────
dotnet_naming_rule.tipos_pascal.symbols  = tipos
dotnet_naming_rule.tipos_pascal.style    = pascal
dotnet_naming_rule.tipos_pascal.severity = warning

dotnet_naming_symbols.tipos.applicable_kinds = class,struct,enum,property,method,namespace
dotnet_naming_symbols.tipos.applicable_accessibilities = *

# ─── Interfaces: I + PascalCase ────────────────────────────────
dotnet_naming_rule.interfaces_com_i.symbols  = interfaces
dotnet_naming_rule.interfaces_com_i.style    = pascal_com_i
dotnet_naming_rule.interfaces_com_i.severity = warning

dotnet_naming_symbols.interfaces.applicable_kinds = interface
dotnet_naming_symbols.interfaces.applicable_accessibilities = *

# ─── 🔴 Campos privados e serviços injetados: _camelCase ───────
dotnet_naming_rule.campos_privados_underscore.symbols  = campos_privados
dotnet_naming_rule.campos_privados_underscore.style    = underscore_camel
dotnet_naming_rule.campos_privados_underscore.severity = warning

dotnet_naming_symbols.campos_privados.applicable_kinds = field
dotnet_naming_symbols.campos_privados.applicable_accessibilities = private,private_protected

# ─── Constantes: PascalCase (não SCREAMING_CASE) ───────────────
dotnet_naming_rule.constantes_pascal.symbols  = constantes
dotnet_naming_rule.constantes_pascal.style    = pascal
dotnet_naming_rule.constantes_pascal.severity = warning

dotnet_naming_symbols.constantes.applicable_kinds = field
dotnet_naming_symbols.constantes.required_modifiers = const

# ─── Parâmetros e locais: camelCase ────────────────────────────
dotnet_naming_rule.parametros_camel.symbols  = parametros
dotnet_naming_rule.parametros_camel.style    = camel
dotnet_naming_rule.parametros_camel.severity = warning

dotnet_naming_symbols.parametros.applicable_kinds = parameter,local
dotnet_naming_symbols.parametros.applicable_accessibilities = *

# ─── Métodos assíncronos: sufixo Async ─────────────────────────
dotnet_naming_rule.assincronos_com_async.symbols  = metodos_assincronos
dotnet_naming_rule.assincronos_com_async.style    = pascal_com_async
dotnet_naming_rule.assincronos_com_async.severity = warning

dotnet_naming_symbols.metodos_assincronos.applicable_kinds = method
dotnet_naming_symbols.metodos_assincronos.required_modifiers = async

# ─── estilos ───────────────────────────────────────────────────
dotnet_naming_style.pascal.capitalization = pascal_case
dotnet_naming_style.camel.capitalization  = camel_case

dotnet_naming_style.underscore_camel.capitalization  = camel_case
dotnet_naming_style.underscore_camel.required_prefix = _

dotnet_naming_style.pascal_com_i.capitalization  = pascal_case
dotnet_naming_style.pascal_com_i.required_prefix = I

dotnet_naming_style.pascal_com_async.capitalization  = pascal_case
dotnet_naming_style.pascal_com_async.required_suffix = Async

# ═══════════════════════════════════════════════════════════════
# ESTILO — o que a skill padroes-codigo manda usar
# ═══════════════════════════════════════════════════════════════
csharp_style_var_when_type_is_apparent = true:warning
csharp_style_var_elsewhere = false:suggestion

csharp_style_expression_bodied_methods = when_on_single_line:suggestion
csharp_style_expression_bodied_properties = true:warning

csharp_style_prefer_primary_constructors = true:warning
csharp_style_prefer_top_level_statements = true:silent

csharp_prefer_simple_using_statement = true:warning
csharp_style_prefer_range_operator = true:warning
csharp_style_prefer_index_operator = true:warning
csharp_style_implicit_object_creation_when_type_is_apparent = true:warning

dotnet_style_collection_initializer = true:warning
dotnet_style_object_initializer = true:warning
dotnet_style_prefer_conditional_expression_over_assignment = true:silent
dotnet_style_null_propagation = true:warning
dotnet_style_coalesce_expression = true:warning
dotnet_style_readonly_field = true:warning

csharp_style_prefer_pattern_matching = true:warning
csharp_style_prefer_not_pattern = true:warning
csharp_style_prefer_switch_expression = true:warning

csharp_prefer_braces = true:warning
csharp_new_line_before_open_brace = all
csharp_new_line_before_else = true
csharp_new_line_before_catch = true
csharp_new_line_before_finally = true

dotnet_style_qualification_for_field = false:warning
dotnet_style_qualification_for_property = false:warning
dotnet_style_qualification_for_method = false:warning

# ═══════════════════════════════════════════════════════════════
# 🔴 ANALISADORES — o que vira ERRO neste projeto
# ═══════════════════════════════════════════════════════════════

# ─── async ─────────────────────────────────────────────────────
dotnet_diagnostic.CS4014.severity = error   # chamada async sem await
dotnet_diagnostic.CA2007.severity = none    # ConfigureAwait: desnecessário em ASP.NET Core
dotnet_diagnostic.CA1849.severity = error   # chamada síncrona dentro de método async
dotnet_diagnostic.CA2016.severity = error   # 🔴 CancellationToken não repassado

# ─── nullable ──────────────────────────────────────────────────
dotnet_diagnostic.CS8600.severity = error
dotnet_diagnostic.CS8602.severity = error   # desreferência de possível null
dotnet_diagnostic.CS8618.severity = error   # não-anulável não inicializado

# ─── correção ──────────────────────────────────────────────────
dotnet_diagnostic.CA1305.severity = warning # IFormatProvider ausente
dotnet_diagnostic.CA1310.severity = error   # 🔴 StringComparison ausente
dotnet_diagnostic.CA2100.severity = error   # 🔴 SQL por concatenação
dotnet_diagnostic.CA5350.severity = error   # algoritmo criptográfico fraco
dotnet_diagnostic.CA5351.severity = error

# ─── ASP.NET Core ──────────────────────────────────────────────
# 🔴 ASP0016 achou um bug de VERDADE: `MapPost("/logout", SairAsync)` ligou na
#    sobrecarga `RequestDelegate` e o `IResult` era descartado calado. Vira erro.
dotnet_diagnostic.ASP0016.severity = error  # 🔴 RequestDelegate descarta o IResult

# ─── EF Core ───────────────────────────────────────────────────
dotnet_diagnostic.EF1001.severity = warning # uso de API interna do EF

# ─── ruído que não ajuda num projeto de um dev ─────────────────
dotnet_diagnostic.CA1062.severity = none    # validar parâmetro público
dotnet_diagnostic.CA1848.severity = none    # LoggerMessage delegates
dotnet_diagnostic.CA1707.severity = none    # underscore em nome (testes usam)

# ═══════════════════════════════════════════════════════════════
# Testes — regras relaxadas
# ═══════════════════════════════════════════════════════════════
[**/Poligraph.Tests/**.cs]
dotnet_diagnostic.CA1707.severity = none    # Metodo_Cenario_Esperado
dotnet_diagnostic.CS8618.severity = none    # fixtures inicializam em InitializeAsync

# ═══════════════════════════════════════════════════════════════
# Migrations — código gerado, não revisar estilo
# ═══════════════════════════════════════════════════════════════
[**/Migrations/*.cs]
generated_code = true
dotnet_analyzer_diagnostic.severity = none

# Chave em todo if, else, for, foreach e while (pedido do autor, 2026-10-03).
dotnet_diagnostic.IDE0011.severity = warning
