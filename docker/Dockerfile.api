# ─── build ────────────────────────────────────────────────────────────
FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build
WORKDIR /src

# copiar SÓ os .csproj primeiro: o restore vira camada cacheada.
#    Mudou só código? O restore sai do cache e o build economiza minutos.
COPY ["src/api/Poligraph.Api/Poligraph.Api.csproj",                       "src/api/Poligraph.Api/"]
COPY ["src/api/Poligraph.Data/Poligraph.Data.csproj",                     "src/api/Poligraph.Data/"]
COPY ["src/api/Poligraph.ServiceDefaults/Poligraph.ServiceDefaults.csproj","src/api/Poligraph.ServiceDefaults/"]
RUN dotnet restore "src/api/Poligraph.Api/Poligraph.Api.csproj"

COPY src/api/ src/api/
RUN dotnet publish "src/api/Poligraph.Api/Poligraph.Api.csproj" \
    -c Release -o /app --no-restore
RUN mkdir -p /chaves

# ─── sonda de saúde ───────────────────────────────────────────────────
# A chiseled não tem shell nem curl, e o health check do container precisa de um programa que faça o
# GET. O wget do BusyBox é estático: roda sem libc e sem shell (testado na chiseled em 2026-10-24).
FROM busybox:1.37.0-musl AS saude

# ─── runtime ──────────────────────────────────────────────────────────
# -chiseled: ~100 MB em vez de ~220 MB, e SEM shell.
# ATENÇÃO: Sem shell, `docker exec ... bash` não funciona. Para depurar, troque
#    temporariamente para mcr.microsoft.com/dotnet/aspnet:10.0
# ATENÇÃO: a variante -extra traz a ICU e os fusos horários. A chiseled comum roda sem idioma
#    (DOTNET_SYSTEM_GLOBALIZATION_INVARIANT=true), e a API quebra ao pedir pt-BR, que ela usa para
#    comparar nomes sem acento ("pt-br is an invalid culture identifier"). MEDIDO no primeiro
#    deploy, 2026-10-15.
FROM mcr.microsoft.com/dotnet/aspnet:10.0-noble-chiseled-extra AS final
WORKDIR /app
COPY --from=build /app .
COPY --from=saude /bin/wget /saude/wget

# ATENÇÃO: a pasta nasce na imagem pertencendo ao usuário da API (1654, o APP_UID das imagens
#    do .NET). Sem isso o volume novo é criado do root, e a API não grava as chaves
#    ("Access to the path '/home/app/chaves/...' is denied"). MEDIDO no primeiro deploy, 2026-10-15.
COPY --from=build --chown=1654:1654 /chaves /home/app/chaves

USER $APP_UID
# Pendência 30: as chaves do Data Protection ficam num volume persistente montado aqui.
# Sem a variável, a API se recusa a subir em produção.
ENV DataProtection__Pasta=/home/app/chaves
VOLUME ["/home/app/chaves"]
EXPOSE 8080
# O /health cobre a API e o banco; o worker e a ETL ficam no /health/componentes, para não marcarem a
# API como fora do ar. O Host é localhost: a API o acrescenta ao AllowedHosts (ConfiguracaoDeSaude).
HEALTHCHECK --interval=30s --timeout=5s --start-period=30s --retries=3     CMD ["/saude/wget", "-q", "-O", "/dev/null", "-T", "4", "http://localhost:8080/health"]
ENTRYPOINT ["dotnet", "Poligraph.Api.dll"]
