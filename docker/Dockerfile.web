FROM node:24-alpine AS build
WORKDIR /web

# ⭐ dependências antes do código: o npm ci vira camada cacheada
COPY src/web/package*.json ./
RUN npm ci

COPY src/web/ .

# 🔴 O Vite CONGELA isto no bundle, em tempo de BUILD.
#    Declarar como env var comum do container NÃO funciona — o valor já foi embutido.
#    No Coolify, declare como *build variable*.
#    Sintoma de errar: o botão do Google não aparece, sem erro nenhum.
ARG VITE_GOOGLE_CLIENT_ID
ENV VITE_GOOGLE_CLIENT_ID=$VITE_GOOGLE_CLIENT_ID
RUN npm run build

FROM nginx:alpine AS final
COPY --from=build /web/dist /usr/share/nginx/html
COPY docker/nginx.conf /etc/nginx/conf.d/default.conf
