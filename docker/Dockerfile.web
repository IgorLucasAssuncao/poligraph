FROM node:24-alpine AS build
WORKDIR /web

# Dependências antes do código: o npm ci vira camada em cache.
COPY src/web/package*.json ./
RUN npm ci

COPY src/web/ .

# RISCO: o Vite grava isto no bundle em tempo de BUILD. Como variável comum do container
# não funciona: o valor já foi embutido. No Coolify, declare como build variable.
# Sintoma de errar: o botão do Google não aparece, sem erro nenhum.
ARG VITE_GOOGLE_CLIENT_ID
ENV VITE_GOOGLE_CLIENT_ID=$VITE_GOOGLE_CLIENT_ID
# O Clarity, pela mesma regra: sem o ID na montagem, o site sai sem ele, e o banner de
# consentimento nem pergunta.
ARG VITE_CLARITY_ID
ENV VITE_CLARITY_ID=$VITE_CLARITY_ID
RUN npm run build

# Imagem sem root (auditoria de 2026-10-03): escuta na 8080, como o nginx.conf.
FROM nginxinc/nginx-unprivileged:alpine AS final
COPY --from=build /web/dist /usr/share/nginx/html
COPY docker/nginx.conf /etc/nginx/conf.d/default.conf
EXPOSE 8080
