# ETL Python. ATENÇÃO: Não é serviço: roda como Scheduled Task do Coolify, executa e morre.
FROM python:3.13-slim
WORKDIR /etl

# dependências antes do código: o pip install vira camada cacheada
COPY src/etl/requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY src/etl/ .

# ATENÇÃO: /cache nasce na imagem pertencendo ao usuário etl. O volume do cache no compose é criado a
#    partir dela; sem isso ele seria do root, e a ETL não gravaria os downloads (o mesmo defeito das
#    chaves da API no primeiro deploy, 2026-10-15).
RUN useradd -m etl && mkdir -p /cache && chown -R etl /etl /cache
ENV POLIGRAPH_CACHE=/cache
USER etl

ENTRYPOINT ["python", "-m", "poligraph_etl"]
