# Aplicador de migrations. Roda, aplica e MORRE — não é serviço.
# RISCO: Em produção é executado ANTES do deploy da API, por um executor só:
#    o zero-downtime do Coolify sobe dois containers da API ao mesmo tempo,
#    e Migrate() concorrente teria corrida.
FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build
WORKDIR /src

# Não copia mais a API: com a dependência invertida, Data não depende dela.
COPY ["src/Poligraph.Data/Poligraph.Data.csproj",                        "src/Poligraph.Data/"]
COPY ["src/Poligraph.ServiceDefaults/Poligraph.ServiceDefaults.csproj", "src/Poligraph.ServiceDefaults/"]
RUN dotnet restore "src/Poligraph.Data/Poligraph.Data.csproj"

COPY src/ src/
RUN dotnet publish "src/Poligraph.Data/Poligraph.Data.csproj" \
    -c Release -o /app --no-restore

# ATENÇÃO: aspnet, não runtime. O Poligraph.Data referencia o ServiceDefaults, que traz o
#    Microsoft.AspNetCore.App; na base runtime o processo nem abre ("No frameworks were found").
#    MEDIDO no primeiro deploy no Coolify, 2026-10-15.
FROM mcr.microsoft.com/dotnet/aspnet:10.0-noble-chiseled AS final
WORKDIR /app
COPY --from=build /app .

USER $APP_UID
ENTRYPOINT ["dotnet", "Poligraph.Data.dll"]
