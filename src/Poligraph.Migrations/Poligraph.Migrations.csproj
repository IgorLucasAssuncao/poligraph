<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Poligraph.Api\Poligraph.Api.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Aspire.Npgsql.EntityFrameworkCore.PostgreSQL" Version="13.5.3" />
    <!-- 🔴 PL49: as migrations moram AQUI, e o `dotnet ef` só funciona no projeto que
         tem este pacote. Ele ficou para trás na mudança, e o comando morria com
         "doesn't reference Microsoft.EntityFrameworkCore.Design". -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.11">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.11" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>


  <ItemGroup>
    <!-- ⚠️ Conteúdo curado precisa acompanhar o binário: o carregador lê de
         AppContext.BaseDirectory, e no container só existe o que foi publicado. -->
    <None Update="curadoria\*.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
