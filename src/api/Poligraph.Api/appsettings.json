{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  // ATENÇÃO: `*` só vale em desenvolvimento, onde o host é `localhost` numa porta que o
  // Aspire sorteia. Em produção o valor real vem de `appsettings.Production.json`:
  // aceitar qualquer `Host` deixa a API responder a requisição endereçada a
  // qualquer domínio que aponte para o mesmo IP, e é assim que se monta um ataque
  // de envenenamento de cabeçalho `Host`.
  "AllowedHosts": "*",
  // Pendência 65 (2026-10-03): o site se lê sem conta; seguir e a conta pedem login.
  "Acesso": {
    "LeituraPublica": true
  }
}
