# ═══════════════════════════════════════════════════════════════════
# Variáveis do FRONT
#
# 🔴 O Vite CONGELA estes valores no bundle, em tempo de BUILD.
#    Defini-los como variável de ambiente do container NÃO funciona — o valor
#    já foi embutido no `npm run build`. No Coolify, declare como BUILD VARIABLE.
#
#    Sintoma de errar: o botão do Google simplesmente não aparece, sem erro nenhum.
# ═══════════════════════════════════════════════════════════════════

# Client ID do OAuth. ⛔ NÃO é segredo — vai para o bundle e é público por natureza.
# Onde obter: console.cloud.google.com → Google Auth Platform → Clients
# ⚠️ Use um por ambiente: poligraph-dev e poligraph-prod (ver plano/02 §3.2.2.4)
VITE_GOOGLE_CLIENT_ID=1234567890-abcdefg.apps.googleusercontent.com

# ID do projeto no Microsoft Clarity. Também não é segredo.
# ⚠️ O script só carrega DEPOIS do aceite no banner — ver BannerConsentimento.tsx
VITE_CLARITY_ID=abcdefghij
