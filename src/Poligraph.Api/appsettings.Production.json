{
  // 🔴 O domínio real, e nada além dele. Em produção a API fica atrás do Traefik e do
  // Cloudflare, e os dois repassam o `Host` que o cliente mandou — então é aqui que
  // ele é conferido.
  //
  // ⚠️ Inclui o subdomínio da API porque o front e a API são servidos por nomes
  // diferentes; o front chama `/api` na MESMA origem, mas o Traefik roteia por host.
  "AllowedHosts": "registroaberto.org;api.registroaberto.org",

  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft.AspNetCore": "Warning"
    }
  }
}
