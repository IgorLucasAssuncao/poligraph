{
  // RISCO: O domínio real, e nada além dele. Em produção a API fica atrás do Traefik e do
  // Cloudflare, e os dois repassam o `Host` que o cliente mandou — então é aqui que
  // ele é conferido.
  //
  // ATENÇÃO: A API não tem nome próprio: o nginx do site repassa `/api` com o `Host` da visita.
  // Por isso a lista é a dos endereços do site, com e sem `www` (2026-10-15).
  "AllowedHosts": "registroaberto.org;www.registroaberto.org",

  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft.AspNetCore": "Warning"
    }
  }
}
