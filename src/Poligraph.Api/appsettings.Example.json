{
  "Google": {
    // ⛔ NÃO é segredo — o Client ID é público por natureza (vai no bundle do front).
    // Onde obter: console.cloud.google.com → Google Auth Platform → Clients
    // ⚠️ Use um por ambiente. O `aud` do token é conferido contra ESTE valor:
    //    com Client IDs distintos, um token de desenvolvimento é rejeitado em produção.
    "ClientId": "1234567890-abcdefg.apps.googleusercontent.com"
    // ⛔ NÃO existe ClientSecret: este fluxo não usa. Ver plano/02 §3.4.0.
  },

  "DataProtection": {
    // 🔴 Sem isto, TODO redeploy desloga todo mundo.
    // As chaves são efêmeras dentro do container; no Coolify, aponte para um VOLUME.
    // Sintoma de esquecer: funciona local, funciona em produção, e quebra sozinho
    // depois de um deploy que não mexeu em autenticação. (Pendência 30)
    "Pasta": "/keys"
  }

  // ConnectionStrings NÃO fica aqui: vem do Aspire em dev, e de variável de
